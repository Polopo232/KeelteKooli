@model KeelteKooli.Models.IndexViewModel
@{
    ViewBag.Title = "Halda kontot";
}

<main aria-labelledby="title">
    <h2 id="title">@ViewBag.Title.</h2>

    <p class="text-success">@ViewBag.StatusMessage</p>
    <div>
        <h4>Muuda oma konto seadeid</h4>
        <hr />
        <dl class="dl-horizontal">
            <dt>Parool:</dt>
            <dd>
                [
                @if (Model.HasPassword)
                {
                    @Html.ActionLink("Muuda parooli", "ChangePassword")
                }
                else
                {
                    @Html.ActionLink("Loo parool", "SetPassword")
                }
                ]
            </dd>
            <dt>Välised sisselogimised:</dt>
            <dd>
                @Model.Logins.Count [
                @Html.ActionLink("Halda", "ManageLogins") ]
            </dd>
            @*
                Telefoninumbreid saab kasutada teise kinnitusmeetodina kaheastmelises autentimises.

                Lisateavet selle ASP.NET rakenduse seadistamise kohta SMS-põhise kaheastmelise autentimise toetamiseks
                leiate <a href="https://go.microsoft.com/fwlink/?LinkId=403804">sellest artiklist</a>.
            *@
