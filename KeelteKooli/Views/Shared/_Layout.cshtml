<!DOCTYPE html>
<html lang="et">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Keelekool</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <style>
        :root {
            --primary-color: #0d6efd;
            --dark-bg: #212529;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8f9fa;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            color: #333;
        }

        /* Красивая навигация */
        .navbar {
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            padding: 0.7rem 0;
            border-bottom: 2px solid var(--primary-color);
        }

        .navbar-brand {
            font-weight: 700;
            font-size: 1.4rem;
            letter-spacing: -0.5px;
        }

        .nav-link {
            font-weight: 500;
            padding: 0.5rem 1rem !important;
            transition: all 0.2s ease;
            border-radius: 8px;
        }

            .nav-link:hover {
                background-color: rgba(255,255,255,0.1);
                color: #fff !important;
            }

        .body-content {
            flex: 1;
            padding-top: 2.5rem;
            padding-bottom: 3rem;
        }

        footer {
            background: #fff;
            padding: 2rem 0;
            border-top: 1px solid #dee2e6;
            margin-top: auto;
        }

        .card {
            border-radius: 15px;
            transition: transform 0.2s ease;
        }

        .btn-primary {
            border-radius: 10px;
            padding: 0.5rem 1.5rem;
            font-weight: 600;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top">
        <div class="container">
            <a class="navbar-brand text-white" href="@Url.Action("Index", "Home")">
                <i class="bi bi-translate text-primary me-2"></i>Keelekool
            </a>

            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Home")">
                            <i class="bi bi-house-door me-1"></i> Avaleht
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Trainings")">
                            <i class="bi bi-book me-1"></i> Kursused
                        </a>
                    </li>

                    @if (User.IsInRole("Student"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("MyCourses", "Trainings")">
                                <i class="bi bi-mortarboard me-1"></i> Minu kursused
                            </a>
                        </li>
                    }

                    @if (User.IsInRole("Teacher") || User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Dashboard", "Teacher")">
                                <i class="bi bi-person-badge me-1"></i> Õpetajad
                            </a>
                        </li>
                    }

                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item text-warning">
                            <a class="nav-link text-warning" href="@Url.Action("Index", "Registrations")">
                                <i class="bi bi-card-checklist me-1"></i> Registreeringud
                            </a>
                        </li>
                    }

                    <li class="nav-item">
                        <a class="nav-link opacity-75" href="@Url.Action("About", "Home")">Meist</a>
                    </li>
                </ul>

                <div class="d-flex align-items-center border-start ps-lg-4 ms-lg-2 border-secondary">
                    @Html.Partial("_LoginPartial")
                </div>
            </div>
        </div>
    </nav>

    <main class="container body-content">
        @RenderBody()
    </main>

    <footer class="text-center text-lg-start bg-white shadow-sm">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start">
                    <p class="mb-0 text-muted">
                        &copy; @DateTime.Now.Year — <span class="fw-bold text-dark">Nikita Nikiforov</span>.
                        Keelekooli infosüsteem
                    </p>
                </div>
                <div class="col-md-6 text-center text-md-end mt-2 mt-md-0">
                    <span class="text-muted small me-3">KeelteKooli Rakendus v2.0</span>
                    <i class="bi bi-shield-check text-success"></i>
                </div>
            </div>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>