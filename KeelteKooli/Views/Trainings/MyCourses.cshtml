@model IEnumerable<KeelteKooli.Models.Training>
@using Microsoft.AspNet.Identity
@using KeelteKooli.Models
@{ ViewBag.Title = "Minu kursused"; }

<div class="container py-4">
    <div class="d-flex align-items-center mb-4">
        <h2 class="mb-0 shadow-sm p-2 bg-primary text-white rounded-3 me-3"><i class="bi bi-journal-bookmark-fill"></i></h2>
        <h2 class="fw-bold text-dark">Minu õppeplaan</h2>
    </div>

    <div class="row">
        @foreach (var t in Model)
        {
            var userId = User.Identity.GetUserId();
            var myReg = t.Registrations?.FirstOrDefault(r => r.ApplicationUserId == userId);

            <div class="col-md-4 mb-4">
                <div class="card h-100 border-0 shadow-sm hover-shadow transition-all" style="border-radius: 15px; overflow: hidden;">
                    <div class="card-header bg-gradient bg-primary text-white border-0 py-3 d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0 fw-bold">@t.Course.Nimetus</h5>

                        @if (myReg != null)
                        {
                            if (myReg.Staatus == RegistrationStatus.Ootel)
                            {
                                <span class="badge bg-warning text-dark" title="Ootab admini kinnitust">
                                    <i class="bi bi-clock-history"></i> Ootel
                                </span>
                            }
                            else if (myReg.Staatus == RegistrationStatus.Kinnitatud)
                            {
                                <span class="badge bg-success">
                                    <i class="bi bi-check-circle"></i> Kinnitatud
                                </span>
                            }
                        }
                    </div>

                    <div class="card-body">
                        @if (myReg != null && myReg.Staatus != RegistrationStatus.Kinnitatud)
                        {
                            <div class="alert alert-warning py-2 small mb-3 text-center border-0" style="border-radius: 10px;">
                                <i class="bi bi-exclamation-triangle-fill"></i> Ootab administraatori kinnitust
                            </div>
                        }

                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-light rounded-circle p-2 me-2">
                                <i class="bi bi-person-badge text-primary"></i>
                            </div>
                            <h6 class="mb-0">@t.Teacher.Nimi</h6>
                        </div>

                        <div class="p-3 bg-light rounded-3 mb-3">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted small">Keel / Tase:</span>
                                <span class="badge bg-info text-dark">@t.Course.Keel @t.Course.Tase</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted small">Maksumus:</span>
                                <span class="fw-bold text-success">@t.Hind €</span>
                            </div>
                        </div>

                        <div class="row text-center g-0 border rounded">
                            <div class="col-6 border-end py-2">
                                <small class="text-muted d-block">Algus</small>
                                <strong>@t.AlgusKuupaev.ToString("dd.MM.yyyy")</strong>
                            </div>
                            <div class="col-6 py-2">
                                <small class="text-muted d-block">Lõpp</small>
                                <strong>@t.LoppKuupaev.ToString("dd.MM.yyyy")</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>