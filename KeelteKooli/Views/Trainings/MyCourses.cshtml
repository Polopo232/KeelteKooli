@model IEnumerable<KeelteKooli.Models.Training>

@{
    ViewBag.Title = "Minu kursused";
}

<h2>Мои курсы</h2>

<div class="row">
    @foreach (var t in Model)
    {
        <div class="col-md-4 mb-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">@t.Course.Nimetus</h5>
                    <h6 class="card-subtitle mb-2 text-muted">@t.Teacher.Nimi</h6>
                    <p class="card-text">
                        @t.Course.Keel - @t.Course.Tase <br />
                        @t.Hind € <br />
                        Начало: @t.AlgusKuupaev.ToShortDateString() <br />
                        Конец: @t.LoppKuupaev.ToShortDateString()
                    </p>
                </div>
            </div>
        </div>
    }
</div>
