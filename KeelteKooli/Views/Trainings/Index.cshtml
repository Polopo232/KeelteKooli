@model IEnumerable<KeelteKooli.Models.Training>

@using KeelteKooli.Models
@using Microsoft.AspNet.Identity

@{
    ViewBag.Title = "Kursused";
}

<h2>Kursused registreerimiseks</h2>

@if (User.IsInRole("Admin"))
{
    <p>
        <a class="btn btn-success" href="@Url.Action("Create", "Trainings")">
            + Lisa kursus
        </a>
    </p>
}

<div class="row">
    @foreach (var t in Model)
    {
        var kinnitatudCount = t.Registrations?
            .Count(r => r.Staatus == RegistrationStatus.Kinnitatud) ?? 0;
        var remainingSeats = t.MaxOsalejaid - kinnitatudCount;

        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">@((t.Course?.Nimetus) ?? "Kursus puudub")</h5>
                    <h6 class="card-subtitle mb-2 text-muted">@((t.Teacher?.Nimi) ?? "Õpetaja puudub")</h6>
                    <p>
                        <strong>Keel / tase:</strong> @((t.Course?.Keel ?? "-")) - @((t.Course?.Tase ?? "-")) <br />
                        <strong>Hind:</strong> @t.Hind € <br />
                        <strong>Algus:</strong> @t.AlgusKuupaev.ToShortDateString() <br />
                        <strong>Lõpp:</strong> @t.LoppKuupaev.ToShortDateString() <br />
                        <strong>Kohti kokku:</strong> @t.MaxOsalejaid <br />
                        <strong>Registreerunud:</strong> @kinnitatudCount <br />
                        <strong>Vabu kohti:</strong> @remainingSeats
                    </p>

                    @if (User.IsInRole("Admin"))
                    {
                        <a href="@Url.Action("Edit", "Trainings", new { id = t.Id })"
                           class="btn btn-warning mb-1">Muuda</a>
                        <a href="@Url.Action("Delete", "Trainings", new { id = t.Id })"
                           class="btn btn-danger mb-1">Kustuta</a>
                    }

                    @if (User.IsInRole("Student"))
                    {
                        var userId = User.Identity.GetUserId();
                        var myRegistration = t.Registrations?
                            .FirstOrDefault(r => r.ApplicationUserId == userId);

                        if (myRegistration == null)
                        {
                            if (remainingSeats > 0)
                            {
                                <a href="@Url.Action("Register", "Trainings", new { id = t.Id })"
                                   class="btn btn-primary">Registreeru</a>
                            }
                            else
                            {
                                <span class="badge bg-danger">Rühm täis</span>
                            }
                        }
                        else
                        {
                            <span class="badge @(myRegistration.Staatus == RegistrationStatus.Ootel ? "bg-warning" : "bg-success")">
                                @myRegistration.Staatus
                            </span>
                        }
                    }
                    else if (User.IsInRole("Teacher"))
                    {
                        <span class="text-muted fst-italic">
                            Ainult vaatamiseks
                        </span>
                    }

                </div>
            </div>
        </div>
    }
</div>
