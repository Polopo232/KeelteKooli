@model KeelteKooli.Models.Training

@{
    ViewBag.Title = "Lisa kursus";
}

<h2>Lisa kursus</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-group">
        @Html.LabelFor(m => m.CourseName, "Kursuse nimetus")
        @Html.TextBoxFor(m => m.CourseName, new { @class = "form-control" })
    </div>

    <div class="form-group">
        @Html.Label("Õpetaja")
        @Html.DropDownList("TeacherId", null, "-- vali õpetaja --", new { @class = "form-control" })
    </div>

    <div class="form-group">
        @Html.Label("Alguskuupäev")
        @Html.TextBoxFor(m => m.AlgusKuupaev, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
    </div>

    <div class="form-group">
        @Html.Label("Lõppkuupäev")
        @Html.TextBoxFor(m => m.LoppKuupaev, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
    </div>

    <div class="form-group">
        @Html.Label("Hind (€)")
        @Html.TextBoxFor(m => m.Hind, new { @class = "form-control", placeholder = "Sisesta hind" })
    </div>

    <div class="form-group">
        @Html.Label("Maksimaalne osalejate arv")
        @Html.TextBoxFor(m => m.MaxOsalejaid, new { @class = "form-control", placeholder = "Sisesta arv" })
    </div>

    <button type="submit" class="btn btn-primary">Salvesta</button>
}
