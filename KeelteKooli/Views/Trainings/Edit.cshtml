@model KeelteKooli.Models.Training

@{
    ViewBag.Title = "Muuda kursust";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <nav aria-label="breadcrumb" class="mb-4">
                <a href="@Url.Action("Index", "Trainings")" class="text-decoration-none text-muted">
                    <i class="bi bi-arrow-left"></i> Tagasi nimekirja juurde
                </a>
            </nav>

            <div class="card border-0 shadow-lg" style="border-radius: 1.5rem;">
                <div class="card-body p-5">

                    <div class="d-flex align-items-center mb-4 border-bottom pb-3">
                        <div class="bg-warning bg-opacity-10 p-3 rounded-circle me-3">
                            <i class="bi bi-pencil-square text-warning fs-3"></i>
                        </div>
                        <div>
                            <h2 class="fw-bold mb-0">Muuda kursust</h2>
                            <small class="text-muted">ID: @Model.Id — @Model.CourseName</small>
                        </div>
                    </div>

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.Id)
                        @Html.HiddenFor(m => m.CourseId)

                        <div class="mb-4">
                            <label class="form-label text-muted small fw-bold text-uppercase">Kursuse nimetus</label>
                            @Html.TextBoxFor(m => m.CourseName, new { @class = "form-control form-control-lg border-2", placeholder = "Sisesta kursuse nimi" })
                            @Html.ValidationMessageFor(m => m.CourseName, "", new { @class = "text-danger small" })
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6 mb-3 mb-md-0">
                                <label class="form-label text-muted small fw-bold text-uppercase">Keel</label>
                                @Html.TextBoxFor(m => m.CourseKeel, new { @class = "form-control", placeholder = "Näiteks: Saksa" })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-muted small fw-bold text-uppercase">Tase</label>
                                @Html.DropDownListFor(m => m.CourseTase,
                                               new SelectList(new[] { "A1", "A2", "B1", "B2", "C1", "C2" }),
                                               new { @class = "form-select" })
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label text-muted small fw-bold text-uppercase">Õpetaja</label>
                            @Html.DropDownListFor(m => m.TeacherId, (SelectList)ViewBag.TeacherId, new { @class = "form-select border-2" })
                        </div>

                        <div class="row p-4 bg-light rounded-4 mb-4 g-3 border">
                            <div class="col-md-6">
                                <label class="small text-muted fw-bold">Alguskuupäev</label>
                                @Html.TextBoxFor(m => m.AlgusKuupaev, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                            </div>
                            <div class="col-md-6">
                                <label class="small text-muted fw-bold">Lõppkuupäev</label>
                                @Html.TextBoxFor(m => m.LoppKuupaev, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                            </div>
                            <div class="col-md-6">
                                <label class="small text-muted fw-bold">Hind (€)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white">€</span>
                                    @Html.TextBoxFor(m => m.Hind, new { @class = "form-control border-start-0", placeholder = "0.00" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="small text-muted fw-bold">Maksimaalne osalejate arv</label>
                                @Html.TextBoxFor(m => m.MaxOsalejaid, new { @class = "form-control", type = "number" })
                            </div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-start align-items-center">
                            <button type="submit" class="btn btn-warning btn-lg px-5 rounded-pill shadow-sm fw-bold">
                                <i class="bi bi-check-circle-fill"></i> Salvesta muudatused
                            </button>
                            <a href="@Url.Action("Index", "Trainings")" class="btn btn-link text-decoration-none text-secondary">Loobu</a>
                        </div>
                    }
                </div>
            </div>

            @if (User.IsInRole("Admin"))
            {
                <div class="mt-4 text-center">
                    <p class="text-muted small">
                        Ettevaatust: Muudatused jõustuvad koheselt kõigile registreeritud kasutajatele.
                    </p>
                </div>
            }
        </div>
    </div>
</div>