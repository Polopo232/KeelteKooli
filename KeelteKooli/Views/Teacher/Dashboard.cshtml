@model IEnumerable<KeelteKooli.Models.Teacher>

@{
    ViewBag.Title = "Õpetajate haldus";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Õpetajate profiilid</h2>
    <a href="@Url.Action("CreateProfile", "Teacher")" class="btn btn-success">
        <i class="bi bi-plus-lg"></i> Lisa uus õpetaja
    </a>
</div>

<table class="table table-hover border">
    <thead class="table-light">
        <tr>
            <th>Nimi</th>
            <th>Kasutaja ID</th>
            <th>Tegevused</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td><strong>@item.Nimi</strong></td>
                <td>@item.ApplicationUserId</td>
                <td>
                    <span class="badge bg-info text-dark">Aktiivne</span>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-4">
    <a href="@Url.Action("Create", "Trainings")" class="btn btn-primary">
        Loo uus kursus (Vali õpetaja)
    </a>
</div>