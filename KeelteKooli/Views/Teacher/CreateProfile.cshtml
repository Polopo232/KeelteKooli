@model KeelteKooli.Models.Teacher

<h2>Lisa uus õpetaja profiil</h2>

@using (Html.BeginForm("CreateProfile", "Teacher", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <div class="card p-4 shadow-sm">
        <div class="mb-3">
            @Html.LabelFor(m => m.Nimi, "Õpetaja nimi")
            @Html.TextBoxFor(m => m.Nimi, new { @class = "form-control" })
        </div>

        <div class="mb-3">
            <label class="form-label">Profiilipilt</label>
            <input type="file" name="upload" class="form-control" accept="image/*" />
        </div>

        <div>
            <button type="submit" class="btn btn-primary">Salvesta õpetaja</button>
            <a href="@Url.Action("Dashboard")" class="btn btn-secondary ms-2">Tagasi</a>
        </div>
    </div>
}